# Copy to .env for local dev, or set these as Railway environment variables.

# Required. A single shared password protecting the whole app (HTTP Basic Auth).
DASHBOARD_PASSWORD=

# Required. Railway injects this automatically once you attach the Postgres add-on.
DATABASE_URL=

# Canvas's own direct calendar feed URL (Account -> Settings -> Calendar Feed in Canvas).
# Confirmed to fetch cleanly from a normal server (tested from a local machine) -
# the earlier bot-blocking only affected requests from Anthropic's own infrastructure.
CANVAS_ICS_URL=

# Your personal Google Calendar's *Secret address in iCal format*
# (Google Calendar -> Settings -> your calendar -> Integrate calendar).
# Do NOT use the .../ical/{email}/public/basic.ics pattern - that only works if the
# calendar's sharing is set to public, which exposes it to anyone who guesses the URL.
PERSONAL_ICS_URL=
